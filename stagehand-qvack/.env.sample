# Required, set at least one AI provider API key.
# If both are set, Anthropic is used by default.
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Required, the Backstage2 MCP endpoint and a key from its MCP_API_KEYS.
# From a container, reach a dev server on the host with host.docker.internal.
BACKSTAGE2_MCP_URL=http://localhost:3000/api/mcp
BACKSTAGE2_MCP_KEY=YOUR_BACKSTAGE2_MCP_KEY

# Required when running without the Slack CLI (python3 app.py or Docker Compose).
# `slack run` sets these itself. The bot token is under OAuth & Permissions in the
# app's settings, and the app-level token (connections:write) under Basic Information.
# SLACK_APP_TOKEN=YOUR_SLACK_APP_TOKEN
# SLACK_BOT_TOKEN=YOUR_SLACK_BOT_TOKEN

# Optional, DEBUG logs every Slack event and model request, including booking data.
# LOG_LEVEL=INFO

# Required for OAuth (app_oauth.py). Set your app's OAuth credentials.
# SLACK_CLIENT_ID=YOUR_SLACK_CLIENT_ID
# SLACK_CLIENT_SECRET=YOUR_SLACK_CLIENT_SECRET
# SLACK_SIGNING_SECRET=YOUR_SLACK_SIGNING_SECRET
# SLACK_REDIRECT_URI=https://YOUR_NGROK_SUBDOMAIN.ngrok-free.app/slack/oauth_redirect

# Optional, uncomment and set when using a custom Slack instance.
# SLACK_API_URL=YOUR_SLACK_API_URL

# Optional logging level (default INFO). Use DEBUG for verbose Slack and AI logs.
# LOG_LEVEL=DEBUG
